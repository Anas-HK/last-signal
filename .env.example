# OPTIONAL: live chat works without keys using Connect Twitch -> Join live chat.
# These credentials enable the optional OAuth / EventSub connection.
# Register a Twitch application: https://dev.twitch.tv/console/apps
# OAuth Redirect URL must match exactly (localhost, not 127.0.0.1):
# http://localhost:3001/auth/twitch/callback
# Category: Game Integration. Confidential client for authorization-code flow.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
APP_URL=http://localhost:3001
PORT=3001
# Bind to loopback by default; this is a local streamer tool.
HOST=127.0.0.1
# Extra Host names allowed to reach the server, comma separated (for example a LAN name).
# ALLOWED_HOSTS=my-pc.local:3001
